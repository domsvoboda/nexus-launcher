+    /// Version
+    #[xmlserde(name = b"Version", ty = "attr")]
+    pub version: Option<String>,
+    /// File name
+    #[xmlserde(name = b"FileName", ty = "attr")]
+    pub filename: Option<String>,
+    /// Packages
+    #[xmlserde(name = b"Package", ty = "child")]
+    pub packages: Vec<Package>,
+}
